; Energy minimization for asphaltene/decane/water system
integrator               = steep
nsteps                   = 50000
emtol                    = 1000.0
emstep                   = 0.01

cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz

coulombtype              = PME
rcoulomb                 = 1.0
epsilon-r                = 1

vdwtype                  = Cut-off
rvdw                     = 1.0
DispCorr                 = EnerPres

constraints              = h-bonds
constraint_algorithm     = LINCS
lincs-order              = 4
